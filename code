/* =======================================================================
   FORMULAIRE DE CONTACT
   ======================================================================= */
const form = document.getElementById("contactForm");
const formMsg = document.getElementById("formMsg");
const submitBtn = document.getElementById("submitBtn");

const validators = {
  "f-name":    () => document.getElementById("name").value.trim().length >= 2,
  "f-email":   () => /^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}$/.test(document.getElementById("email").value.trim()),
  "f-type":    () => document.getElementById("projectType").value !== "",
  "f-message": () => document.getElementById("message").value.trim().length >= 10
};
Object.keys(validators).forEach(id=>{
  const w = document.getElementById(id);
  const input = w.querySelector("input,select,textarea");
  input.addEventListener("input", ()=>{ if(validators[id]()) w.classList.remove("has-error"); });
  input.addEventListener("change", ()=>{ if(validators[id]()) w.classList.remove("has-error"); });
});

function showSuccess(text){
  formMsg.className = "form__msg is-shown";
  formMsg.innerHTML = "✅ " + text;
  toast("Demande transmise avec succès.");
}

form.addEventListener("submit", async (e)=>{
  e.preventDefault();
  let ok = true, firstBad = null;
  Object.keys(validators).forEach(id=>{
    const w = document.getElementById(id);
    const valid = validators[id]();
    w.classList.toggle("has-error", !valid);
    if(!valid){ ok = false; if(!firstBad) firstBad = w.querySelector("input,select,textarea"); }
  });
  if(!ok){
    formMsg.classList.remove("is-shown");
    if(firstBad) firstBad.focus();
    toast("Merci de compléter correctement les champs obligatoires.");
    return;
  }

  const data = {
    name: document.getElementById("name").value.trim(),
    email: document.getElementById("email").value.trim(),
    projectType: document.getElementById("projectType").value,
    message: document.getElementById("message").value.trim()
  };

  submitBtn.disabled = true;
  const original = submitBtn.innerHTML;
  submitBtn.innerHTML = "Envoi en cours…";

  /* CAS 1 — un service d'envoi est configuré */
  if(CONFIG.formEndpoint){
    try{
      const fd = new FormData();
      Object.keys(data).forEach(k => fd.append(k, data[k]));
      const res = await fetch(CONFIG.formEndpoint, {method:"POST", body:fd, headers:{"Accept":"application/json"}});
      if(res.ok){
        showSuccess("Merci " + data.name.split(" ")[0] + " ! Votre demande a bien été envoyée. Je reviens vers vous rapidement.");
        form.reset();
      } else { throw new Error("bad response"); }
    }catch(err){
      submitBtn.disabled = false; submitBtn.innerHTML = original;
      formMsg.className = "form__msg is-shown";
      formMsg.innerHTML = "L’envoi automatique a échoué. Vérifiez la valeur de <code>CONFIG.formEndpoint</code>, ou écrivez directement à <strong>" + (CONFIG.email || "votre adresse e-mail") + "</strong>.";
    }
    return;
  }

  /* CAS 2 — aucun service configuré */
  setTimeout(()=>{
    submitBtn.disabled = false;
    submitBtn.innerHTML = original;
    if(CONFIG.email){
      const subject = encodeURIComponent("Nouveau projet web — " + data.projectType);
      const body = encodeURIComponent(
        "Nom : " + data.name + "\nE-mail : " + data.email +
        "\nType de projet : " + data.projectType + "\n\nMessage :\n" + data.message
      );
      window.location.href = "mailto:" + CONFIG.email + "?subject=" + subject + "&body=" + body;
      showSuccess("Votre demande est prête : votre logiciel de messagerie va s’ouvrir pour l’envoyer à " + CONFIG.email + ".");
    } else {
      formMsg.className = "form__msg is-shown";
      formMsg.innerHTML =
        "✅ <strong>Demande enregistrée localement.</strong> Aucun service d’envoi n’est encore configuré : " +
        "renseignez <code>CONFIG.email</code> (ouverture du logiciel de messagerie) ou <code>CONFIG.formEndpoint</code> " +
        "(envoi automatique via Formspree, Web3Forms, Getform, Netlify Forms ou EmailJS) pour recevoir les messages.";
      toast("Formulaire fonctionnel — pensez à configurer CONFIG.email ou CONFIG.formEndpoint.");
    }
  }, 700);
});

